# Secrets and local overrides
.env
.env.*
!.env.example
docker-compose.override.yml

# Python environments and caches
**/.venv*/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.egg-info/
**/.coverage
**/coverage.xml
**/htmlcov/

# Frontend dependencies/build output
frontend/node_modules/
frontend/dist/

# Authoritative local application data
backend/docvault.db
backend/docvault.db-*
backend/storage/
backend/.runtime/

# Baseline backup/restore payloads contain real documents and database data.
# Keep the human-readable reports only when an evidence repository is configured.
artifacts/baseline/*/backup/
artifacts/baseline/*/restore/
artifacts/baseline/*/isolation/

# Local logs and debug dumps
*.log

# Temporary and non-essential text/log files
*.txt
!**/requirements.txt
!backend/tests/fixtures/**
!artifacts/baseline/**

# Documents, Spreadsheets, Audio & Video files
*.pdf
*.xlsx
*.xls
*.xlsm
*.xlsb
*.ods
*.csv
*.mp3
*.wav
*.m4a
*.aac
*.ogg
*.flac
*.wma
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wmv
*.flv
*.m4v

# Ignore Markdown documentation except the root README
*.md
!/README.md
secrets/
hf_cache/
lancedb/
lancedb_data/
data/
