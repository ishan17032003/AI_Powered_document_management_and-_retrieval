# Production starts only after every required value passes the CFG-002 validator.
DOCVAULT_ENVIRONMENT=production
DOCVAULT_DEBUG=false
DOCVAULT_ENABLE_DEMO_SEED=false
DOCVAULT_DATABASE_URL=
DOCVAULT_SECRET_KEY=
DOCVAULT_STORAGE_DIR=/srv/docvault/storage
DOCVAULT_OKF_BUNDLE_DIR=/srv/docvault/okf
DOCVAULT_ACCESS_TOKEN_MINUTES=60
DOCVAULT_CORS_ORIGINS=[]
DOCVAULT_FOLDER_IMPORT_ENABLED=false
DOCVAULT_FOLDER_IMPORT_ROOTS=[]
DOCVAULT_FOLDER_IMPORT_MAX_VISITED_ENTRIES=5000
DOCVAULT_FOLDER_IMPORT_MAX_FILES=500
DOCVAULT_FOLDER_IMPORT_MAX_TOTAL_MB=500
DOCVAULT_FOLDER_IMPORT_MAX_DEPTH=10
DOCVAULT_FOLDER_IMPORT_MAX_SECONDS=30
DOCVAULT_LLM_PROVIDER=none
DOCVAULT_ALLOW_EXTERNAL_LLM=false
DOCVAULT_LLM_ALLOWED_HOSTS=[]
DOCVAULT_VISUAL_SEMANTIC_MIN_SCORE=0.08
DOCVAULT_RAG_PROVIDER_CONNECT_TIMEOUT_SECONDS=3
DOCVAULT_RAG_PROVIDER_READ_TIMEOUT_SECONDS=20
DOCVAULT_RAG_PROVIDER_TOTAL_TIMEOUT_SECONDS=30
DOCVAULT_RAG_PROVIDER_MAX_OUTPUT_TOKENS=512
DOCVAULT_RAG_MAX_CONTEXT_BYTES=32768
DOCVAULT_RAG_PROVIDER_MAX_CONCURRENCY=2
DOCVAULT_VLLM_URL=
DOCVAULT_OLLAMA_URL=
DOCVAULT_ANTHROPIC_URL=https://api.anthropic.com

# ── Host paths (Docker Compose variable substitution only) ────────────────────
# Both are OPTIONAL. Left unset, they default to ./hf_cache and ./lancedb next
# to docker-compose.yml, so a fresh clone starts on any machine or OS with no
# configuration. Set either to an ABSOLUTE path to relocate the data — most
# often to move the multi-GB model cache onto a larger disk.
#
# On native Linux, Docker creates a missing bind directory as root:root while
# the containers run as UID 10001, so create them yourself first:
#   mkdir -p hf_cache lancedb && sudo chown -R 10001:10001 hf_cache lancedb
# Docker Desktop (Windows/macOS) needs no such step.
#
#HF_CACHE_HOST_PATH=
#LANCEDB_HOST_PATH=
