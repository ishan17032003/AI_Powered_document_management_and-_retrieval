# Production starts only after every required value passes the CFG-002 validator.
DOCVAULT_ENVIRONMENT=development
DOCVAULT_DEBUG=false
DOCVAULT_SECRET_KEY=
DOCVAULT_ACCESS_TOKEN_MINUTES=60
DOCVAULT_MAX_UPLOAD_MB=10240
DOCVAULT_CORS_ORIGINS=[]
DOCVAULT_TRUSTED_PROXY_CIDRS=[]
GUNICORN_WORKERS=2

# ── Service URLs & FQDNs (Reverse proxy / Deployment routing) ─────────────────
SERVICE_URL_FRONTEND=
SERVICE_FQDN_FRONTEND=
SERVICE_URL_BACKEND=
SERVICE_FQDN_BACKEND=
SERVICE_URL_INGESTION_WORKER=
SERVICE_FQDN_INGESTION_WORKER=
SERVICE_URL_MIGRATION=
SERVICE_FQDN_MIGRATION=
SERVICE_URL_LANCEDB_INIT=
SERVICE_FQDN_LANCEDB_INIT=

# ── LLM Inference & Provider Configuration ────────────────────────────────────
DOCVAULT_LLM_PROVIDER=vllm
DOCVAULT_ALLOW_EXTERNAL_LLM=true
DOCVAULT_ALLOW_INSECURE_LLM_HTTP=true
DOCVAULT_LLM_ALLOWED_HOSTS=["154.221.33.201"]
DOCVAULT_VLLM_MODEL=gemma-4-31b
DOCVAULT_VLLM_URL=http://154.221.33.201:8000/v1
DOCVAULT_OLLAMA_URL=
DOCVAULT_ANTHROPIC_URL=https://api.anthropic.com

# ── Object Storage & MinIO ───────────────────────────────────────────────────
DOCVAULT_STORAGE_BACKEND=minio
DOCVAULT_MINIO_ENDPOINT=minio:9000
DOCVAULT_MINIO_BUCKET_PREFIX=docvault
DOCVAULT_MINIO_SECURE=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Embeddings & Vector Retrieval ─────────────────────────────────────────────
DOCVAULT_RETRIEVAL_READ_MODE=lancedb_primary
DOCVAULT_EMBEDDING_MODEL=BAAI/bge-m3
DOCVAULT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
DOCVAULT_USE_DOCLING=true
DOCVAULT_SKIP_MODEL_PREFETCH=false
DOCVAULT_LANCEDB_TABLE_NAME=text_chunks
DOCVAULT_LANCEDB_TEXT_VECTORS_ENABLED=true
DOCVAULT_LANCEDB_WRITER_ENABLED=true
DOCVAULT_LANCEDB_LOCK_TIMEOUT_SECONDS=5.0
DOCVAULT_USE_QDRANT=true
DOCVAULT_QDRANT_URL=http://localhost:6333
DOCVAULT_QDRANT_COLLECTION=docvault
DOCVAULT_QDRANT_IMAGE=qdrant/qdrant:latest
DOCVAULT_QDRANT_VECTOR_SIZE=1024

# ── Visual Search & SigLIP 2 ──────────────────────────────────────────────────
DOCVAULT_VISUAL_SEARCH_ENABLED=true
DOCVAULT_VISUAL_SEMANTIC_SEARCH_ENABLED=true
DOCVAULT_VISUAL_SEMANTIC_INGESTION_ENABLED=true
DOCVAULT_VISUAL_SEMANTIC_MODEL_PATH=/data/storage/docvault-siglip2
DOCVAULT_VISUAL_SEMANTIC_DEVICE=cpu
DOCVAULT_VISUAL_SEMANTIC_DIMENSION=768
DOCVAULT_VISUAL_SEMANTIC_MANIFEST_VERSION=visual-semantic-v1
DOCVAULT_VISUAL_SEMANTIC_MAX_BATCH=4
DOCVAULT_VISUAL_SEMANTIC_MAX_QUERY_ASSETS=5000
DOCVAULT_VISUAL_SEMANTIC_MIN_SCORE=0.08
DOCVAULT_VISUAL_SEMANTIC_PREFILTER_MAX_IDS=10000
DOCVAULT_VISUAL_SEMANTIC_QUERY_TIMEOUT_SECONDS=90
DOCVAULT_VISUAL_LANE_CANDIDATE_BUDGET=20
DOCVAULT_VISUAL_MAX_ASSETS_PER_VERSION=2000
DOCVAULT_VISUAL_RERANKER_ENABLED=false
DOCVAULT_VISUAL_SEARCH_MAX_CANDIDATES=500
DOCVAULT_VISUAL_GENERATION_ENABLED=false
DOCVAULT_VISUAL_GENERATION_PROVIDER=none

# ── Extraction & Ingestion Limits ─────────────────────────────────────────────
DOCVAULT_PDF_BATCH_SIZE=10
DOCVAULT_EXTRACTION_MAX_WORKERS=8
DOCVAULT_MAX_EXTRACTION_SECONDS=600
DOCVAULT_PDF_BATCH_MAX_RETRIES=3
DOCVAULT_INGESTION_WORKER_COUNT=1
DOCVAULT_OCR_LANGUAGES=["eng", "hin"]
DOCVAULT_MAX_DOCUMENT_PAGES=10000
DOCVAULT_MAX_EXTRACTED_TEXT_CHARS=5000000
DOCVAULT_MAX_IMAGE_PIXELS=100000000
DOCVAULT_MAX_ARCHIVE_COMPRESSION_RATIO=1000
DOCVAULT_MAX_ARCHIVE_ENTRIES=10000
DOCVAULT_MAX_ARCHIVE_UNCOMPRESSED_MB=500
DOCVAULT_MFA_REQUIRED=false

# ── Ask AI / Conversational RAG & Session Persistence ─────────────────────────
MONGO_ROOT_USER=mongoadmin
MONGO_ROOT_PASSWORD=mongoadmin
DOCVAULT_MONGODB_URL=mongodb://mongoadmin:mongoadmin@mongodb:27017/ask_ai?authSource=admin
DOCVAULT_ASK_AI_MAX_HISTORY_TURNS=20
DOCVAULT_ASK_AI_GDRIVE_MAX_DOCS=5
DOCVAULT_ASK_AI_DAILY_COST_LIMIT_USD=0
DOCVAULT_ASK_AI_DAILY_TOKEN_LIMIT=0
DOCVAULT_ASK_AI_DAILY_SANDBOX_LIMIT=0
DOCVAULT_ASK_AI_MAX_CONCURRENT_RUNS=0
DOCVAULT_ASK_AI_TOOLS_ENABLED=true
DOCVAULT_ASK_AI_SANDBOX_ENABLED=true
DOCVAULT_RAG_CHUNK_MAX_CHARS=3500
DOCVAULT_RAG_CHUNK_OVERLAP_CHARS=350
DOCVAULT_RAG_PROVIDER_CONNECT_TIMEOUT_SECONDS=3
DOCVAULT_RAG_PROVIDER_READ_TIMEOUT_SECONDS=20
DOCVAULT_RAG_PROVIDER_TOTAL_TIMEOUT_SECONDS=30
DOCVAULT_RAG_PROVIDER_MAX_OUTPUT_TOKENS=512
DOCVAULT_RAG_MAX_CONTEXT_BYTES=32768
DOCVAULT_RAG_PROVIDER_MAX_CONCURRENCY=2

# ── Google Drive OAuth (Optional integration) ─────────────────────────────────
DOCVAULT_GOOGLE_CLIENT_ID=
DOCVAULT_GOOGLE_CLIENT_SECRET=
DOCVAULT_GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/callback

# ── Multi-LLM API Keys ───────────────────────────────────────────────────────
DOCVAULT_OPENAI_API_KEY=""
DOCVAULT_ANTHROPIC_API_KEY=""
DOCVAULT_GEMINI_API_KEY=""
HF_TOKEN=

# ── Host Storage Paths (Docker Compose variable substitution) ─────────────────
HF_CACHE_HOST_PATH=./hf_cache
LANCEDB_HOST_PATH=./lancedb

# ── Demo & Seed Settings ──────────────────────────────────────────────────────
DOCVAULT_ENABLE_DEMO_SEED=true
DOCVAULT_DEMO_FIXED_CREDENTIALS=true
